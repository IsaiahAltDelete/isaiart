@name   pixel-icons
@scale  8

# Pixel Art theme icon set (smt/theme.css). One 9x9 frame per icon, named by
# the Material Symbols ligature the page writes (the data-icon attribute).
# X is ink: the build paints it in currentColor, so every icon follows the
# text colour it sits in. Edit here, then run: python smt/icons/build.py

@palette
X #f4f4f4  ink

